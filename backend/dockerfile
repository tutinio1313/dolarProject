FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /App

COPY "backend/" "backend/"
COPY "common/" "common/"
RUN dotnet restore "/App/backend/backend.csproj"

WORKDIR /App/
RUN dotnet publish "/App/backend/backend.csproj" -o /Out

WORKDIR /Out
RUN dotnet dev-certs https -ep ./aspnetapp.pfx -p wyrmxqcwxrQUNfekEHFYFFrwNYnCLw



FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /App/
COPY --from=build /Out .
EXPOSE 1313
EXPOSE 1331
ENTRYPOINT ["dotnet", "backend.dll"]
